{
  "course_id": "AI101",
  "course_name": "人工智能导论",
  "course_name_en": "Introduction to Artificial Intelligence",
  "version": "1.0.0",
  "last_updated": "2026-04-29",
  "target_audience": "大学本科低年级至中年级学生（大一至大三）",
  "prerequisites": [
    "高等数学（微积分、线性代数基础）",
    "概率论与数理统计基础",
    "Python 编程基础"
  ],
  "course_objectives": [
    "了解人工智能的发展历程、核心分支与前沿趋势",
    "掌握智能体、搜索、知识表示等经典AI方法的基本原理",
    "理解机器学习与深度学习的核心思想和常用算法",
    "了解自然语言处理、计算机视觉、强化学习等主要应用方向",
    "认识生成式AI与大语言模型的工作原理与应用场景",
    "具备AI伦理与安全意识，能批判性地看待AI技术",
    "能够动手完成一个简单的AI应用项目"
  ],
  "total_chapters": 13,
  "total_estimated_hours": 64,
  "resource_types": [
    "讲解文档",
    "思维导图",
    "练习题",
    "拓展阅读",
    "代码实操",
    "PPT",
    "动画脚本"
  ],
  "difficulty_levels": {
    "1": "入门（无需AI背景）",
    "2": "基础（需编程和数学基础）",
    "3": "进阶（需理解前置AI概念）",
    "4": "综合应用（需整合多个知识点）"
  },
