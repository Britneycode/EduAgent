    "代码案例",
    "PPT 大纲",
    "动画脚本",
    "图示说明",
    "板书提纲",
    "治理清单"
  ],
  "difficulty_levels": {
    "easy": "基础理解与概念识别",
    "medium": "协议机制解释与典型流程分析",
    "hard": "综合计算、抓包分析与跨层问题定位"
  },
