{
  "course_id": "CN101",
  "course_slug": "computer_networks",
  "course_name": "计算机网络",
  "course_name_en": "Computer Networks",
  "description": "面向高等教育场景的计算机网络课程知识库，覆盖分层体系、物理层、数据链路层、网络层、运输层、应用层、网络安全、实验、题库、代码案例与多媒体教学资源。",
  "version": "0.1.0",
  "last_updated": "2026-05-19",
  "target_audience": "高等教育计算机相关专业学生、教师与多智能体学习系统",
  "prerequisites": [
    "计算机基础",
    "操作系统基本概念",
    "Python 或任意一门程序设计语言基础"
  ],
  "course_objectives": [
    "理解计算机网络的体系结构、协议分层与核心设计原则",
    "掌握物理层、数据链路层、网络层、运输层与应用层的关键协议和机制",
    "能够分析 IP 编址、子网划分、TCP 连接管理、DNS 解析、HTTP/HTTPS 等典型问题",
    "能够使用 Wireshark、ping、traceroute 等工具完成基础网络实验",
    "形成面向网络安全、无线网络和可信通信的基本分析能力",
    "能够通过题库、代码案例和媒体资源进行多形态学习与复习"
  ],
  "total_chapters": 13,
  "total_estimated_hours": 58,
  "resource_types": [
    "讲解文档",
    "事实卡",
    "实验文档",
