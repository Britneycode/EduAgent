    },
    {
      "id": "cn_ip",
      "name": "IP协议",
      "type": "protocol",
      "chapter_id": "cn04",
      "description": "网络层核心协议，提供无连接、不可靠的分组交付。"
    },
    {
      "id": "cn_subnet",
      "name": "子网划分",
      "type": "skill",
      "chapter_id": "cn04",
