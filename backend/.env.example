# EduAgent 后端环境变量示例
# 复制此文件为 .env 并填入实际值

# 数据库（MVP 使用 SQLite）
DATABASE_URL=sqlite+aiosqlite:///./eduagent.db

# DeepSeek（主 LLM）
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI 兼容模型（备用 LLM；例如阿里云百炼 DashScope，主模型失败时自动回退）
OPENAI_COMPATIBLE_ENABLED=false
OPENAI_COMPATIBLE_PROVIDER=阿里云百炼
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_COMPATIBLE_MODEL=qwen3.6-plus
# 百炼 Qwen3 系列如需非思考模式可设为 false；留空则不发送该参数
OPENAI_COMPATIBLE_ENABLE_THINKING=

# DashScope 专用能力（语音识别 / 图片生成）
# 注意：ASR 和图片生成必须单独配置 DASHSCOPE_API_KEY，不复用 DeepSeek 或 OpenAI 兼容模型 Key。
DASHSCOPE_API_KEY=

# 开发模式（设为 true 时使用模拟 LLM 响应，演示/提交时必须设为 false）
LLM_DEV_MODE=false

# 资源生成最大并发数（设为 1 时为无强制等待的串行生成）
RESOURCE_CONCURRENCY=2

# 相关视频联网搜索（默认使用 Tavily 搜索 B站视频；未配置 Key 时会在 /health 返回 video_search_warning）
VIDEO_SEARCH_ENABLED=true
VIDEO_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com
VIDEO_SEARCH_DOMAINS=["bilibili.com"]
VIDEO_SEARCH_MAX_RESULTS=5

# 缓存（REDIS_URL 为空时使用进程内 TTL 缓存）
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1800
CACHE_MEMORY_MAX_ITEMS=512
REDIS_URL=

# JWT 认证
# 生产环境必须设置 APP_ENV=production 且提供稳定的 JWT_SECRET_KEY，否则服务会拒绝启动。
APP_ENV=development
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# Wiki 知识中枢
WIKI_VECTOR_BACKEND=auto
WIKI_CHROMA_DIR=./chroma_data
WIKI_CHROMA_HOST=
WIKI_CHROMA_PORT=8001
WIKI_CHROMA_SSL=false
WIKI_CHROMA_COLLECTION=eduagent_wiki
WIKI_KNOWLEDGE_DIR=./knowledge/ai_intro
WIKI_EMBEDDING_DEV_MODE=true
WIKI_AUTO_INGEST=true

# 本地资产存储（PPTX/Markdown/音频导出文件）
ASSET_STORAGE_DIR=./storage/assets
ASSET_PUBLIC_URL_PREFIX=/api/assets

# CORS 允许源
# 生产环境请只填写真实前端域名，不要使用 "*" 或保留 localhost。
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
