# EduAgent 后端环境变量示例
# 复制此文件为 .env 并填入实际值

# 数据库（MVP 使用 SQLite）
DATABASE_URL=sqlite+aiosqlite:///./eduagent.db

# 讯飞星火（主 LLM）
# 真实调用需要 SPARK_APP_ID + SPARK_API_PASSWORD（或 SPARK_API_KEY）可用。
# 未配置且 SPARK_DEV_MODE=false、DEEPSEEK_ENABLED=false 时，/health 会返回 llm_warning，聊天生成会失败。
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_API_PASSWORD=
SPARK_MODEL=lite
SPARK_API_BASE_URL=https://spark-api-open.xf-yun.com/v1

# DeepSeek 备用 LLM（可选；星火不可用时自动回退）
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 开发模式（设为 true 时使用模拟 LLM 响应，演示/提交时必须设为 false）
SPARK_DEV_MODE=true

# 讯飞大模型安全护栏（内容审核，可选）
# XUNFEI_SAFETY_ENABLED=false 时仅使用本地规则；启用但凭证缺失时会在 /health 返回 safety_warning 并回退本地规则。
XUNFEI_SAFETY_ENABLED=false
XUNFEI_SAFETY_APP_ID=
XUNFEI_SAFETY_ACCESS_KEY_ID=
XUNFEI_SAFETY_ACCESS_KEY_SECRET=
XUNFEI_SAFETY_API_BASE_URL=http://audit-api-spark-dx.iflyaisol.com
XUNFEI_SAFETY_TEMPLATE_ID=

# 讯飞在线语音合成 TTS（资源朗读，可选；未单独配置时会复用 SPARK_* 凭证）
# XUNFEI_TTS_ENABLED=false 时资源朗读接口返回不可用；启用但凭证缺失时 /health 返回 tts_warning。
XUNFEI_TTS_ENABLED=false
XUNFEI_TTS_APP_ID=
XUNFEI_TTS_API_KEY=
XUNFEI_TTS_API_SECRET=
XUNFEI_TTS_URL=wss://tts-api.xfyun.cn/v2/tts
XUNFEI_TTS_VOICE=xiaoyan
XUNFEI_TTS_SPEED=50
XUNFEI_TTS_VOLUME=50
XUNFEI_TTS_PITCH=50

# 缓存（REDIS_URL 为空时使用进程内 TTL 缓存）
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1800
CACHE_MEMORY_MAX_ITEMS=512
REDIS_URL=

# 教师面板访问白名单（逗号分隔；默认空表示不开放多用户聚合视图）
TEACHER_DASHBOARD_ALLOWED_USERNAMES=
TEACHER_DASHBOARD_ALLOWED_USER_IDS=

# Wiki 知识中枢
WIKI_VECTOR_BACKEND=auto
WIKI_CHROMA_DIR=./chroma_data
WIKI_CHROMA_HOST=
WIKI_CHROMA_PORT=8001
WIKI_CHROMA_SSL=false
WIKI_CHROMA_COLLECTION=eduagent_wiki
WIKI_KNOWLEDGE_DIR=./knowledge/ai_intro
WIKI_EMBEDDING_DEV_MODE=true
WIKI_AUTO_INGEST=true

# 本地资产存储（PPTX/Markdown/音频导出文件）
ASSET_STORAGE_DIR=./storage/assets
ASSET_PUBLIC_URL_PREFIX=/api/assets

# CORS 允许源
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
