{
  "course_id": "ALG101",
  "course_slug": "algorithm_design",
  "course_name": "算法设计与分析",
  "course_name_en": "Algorithm Design and Analysis",
  "description": "面向高等教育计算机专业学生的算法课程知识库，覆盖复杂度分析、分治、动态规划、贪心、图算法、字符串匹配、回溯与复杂度理论，配套习题、代码案例与学习路径。",
  "version": "0.1.0",
  "last_updated": "2026-08-29",
  "target_audience": "高等教育计算机相关专业学生、教师与多智能体学习系统",
  "prerequisites": [
    "程序设计语言基础（推荐 Python 或 C/C++）",
    "离散数学（集合、图、逻辑基础）",
    "数据结构基础（数组、链表、栈、队列、树、图）"
  ],
  "course_objectives": [
    "掌握算法时间与空间复杂度的分析与比较方法",
    "理解分治、动态规划、贪心等经典算法设计范式",
    "掌握图算法、字符串匹配等核心算法及其应用",
    "理解回溯与分支限界在组合优化中的应用",
    "认识计算复杂性理论，理解 P、NP、NP 完全的基本概念",
    "能够分析实际问题并设计正确、高效的算法"
  ],
  "total_chapters": 10,
  "total_estimated_hours": 56,
  "resource_types": [
    "讲解文档",
    "习题",
    "实验",
    "代码案例",
    "思维导图",
    "PPT 大纲",
    "动画脚本",
    "图示说明"
  ],
  "difficulty_levels": {
    "1": "入门（需编程基础）",
    "2": "基础（需数据结构和离散数学基础）",
    "3": "进阶（需理解前置算法概念）",
    "4": "综合应用（需整合多个算法范式）"
  },
